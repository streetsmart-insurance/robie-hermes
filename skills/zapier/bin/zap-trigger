#!/usr/bin/env python3
"""POST an EZLynx follow-up task payload to the agency Zapier Catch Hook.

Reads the hook URL from (first match wins) and never prints it:
  1. env ZAPIER_CATCH_HOOK_URL
  2. env CUSTOM_ZAPIER_WEBHOOK
  3. env HERMES_CUSTOM_ZAPIER_WEBHOOK
  4. file $HERMES_HOME/secrets/custom.zapier-webhook (default ~/.hermes/...)
  5. file /workspace/.secrets/zapier-catch-hook.url, ~/workspace/.secrets/...

Stdout is always a single JSON object: {"ok": bool, ...}
Exit 0 on ok, 1 on Zap/HTTP failure, 2 on local config/payload error.
"""
from __future__ import annotations

import argparse
import json
import os
import sys
import urllib.error
import urllib.request
from datetime import datetime
from pathlib import Path

ALLOWED_URL_PREFIX = "https://hooks.zapier.com/"
REQUIRED_PAYLOAD_KEYS = ("applicant_id", "task_title", "assignee", "source", "due_date")
URL_ENV_KEYS = ("ZAPIER_CATCH_HOOK_URL", "CUSTOM_ZAPIER_WEBHOOK", "HERMES_CUSTOM_ZAPIER_WEBHOOK")


def _url_file_candidates() -> list[Path]:
    hermes = Path(os.environ.get("HERMES_HOME") or Path.home() / ".hermes")
    return [
        hermes / "secrets" / "custom.zapier-webhook",
        Path("/workspace/.secrets/zapier-catch-hook.url"),
        Path.home() / "workspace" / ".secrets" / "zapier-catch-hook.url",
    ]


def read_url() -> str | None:
    for key in URL_ENV_KEYS:
        val = (os.environ.get(key) or "").strip()
        if val:
            return val
    for path in _url_file_candidates():
        try:
            text = path.read_text(encoding="utf-8").strip()
        except OSError:
            continue
        if text:
            return text.splitlines()[0].strip()
    return None


def validate_payload(payload: object) -> str | None:
    """Return an error message, or None when the payload is valid.

    Normalizes due_date in place to canonical ISO form.
    """
    if not isinstance(payload, dict):
        return "payload must be a JSON object"
    missing = [key for key in REQUIRED_PAYLOAD_KEYS if not str(payload.get(key) or "").strip()]
    if missing:
        return "payload missing required keys: " + ", ".join(missing)
    due = str(payload["due_date"]).strip()
    try:
        payload["due_date"] = datetime.strptime(due, "%Y-%m-%d").date().isoformat()
    except ValueError:
        return f"due_date must be ISO YYYY-MM-DD, got {due!r}"
    assignee = str(payload["assignee"]).strip()
    if any(ch.isspace() for ch in assignee):
        return (
            "assignee must be an EZLynx login, not a display name "
            f"(got {assignee!r}; e.g. Nicole Segovia -> SSNicole)"
        )
    return None


def _emit(obj: dict, code: int) -> int:
    sys.stdout.write(json.dumps(obj, separators=(",", ":")) + "\n")
    return code


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description="Fire Zapier EZLynx follow-up Catch Hook")
    parser.add_argument("--payload", required=True, help="JSON object payload")
    parser.add_argument("--dry-run", action="store_true", help="Validate only; do not POST")
    parser.add_argument(
        "--applicant-verified",
        action="store_true",
        help="Caller affirms applicant_id is proven in EZLynx (passthrough flag)",
    )
    try:
        args = parser.parse_args(argv)
    except SystemExit:
        return _emit({"ok": False, "error": "invalid arguments"}, 2)

    try:
        payload = json.loads(args.payload)
    except json.JSONDecodeError as exc:
        return _emit({"ok": False, "error": f"invalid JSON payload: {exc.msg}"}, 2)

    error = validate_payload(payload)
    if error:
        return _emit({"ok": False, "error": error}, 2)

    url = read_url()
    if not url:
        return _emit(
            {"ok": False, "error": "zapier webhook URL missing (custom.zapier-webhook / ZAPIER_CATCH_HOOK_URL)"},
            2,
        )
    if not url.startswith(ALLOWED_URL_PREFIX):
        return _emit({"ok": False, "error": "webhook URL host not allowed"}, 2)

    if args.dry_run:
        return _emit(
            {
                "ok": True,
                "dry_run": True,
                "applicant_verified": bool(args.applicant_verified),
                "payload_keys": sorted(payload.keys()),
            },
            0,
        )

    req = urllib.request.Request(
        url,
        data=json.dumps(payload).encode("utf-8"),
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=60) as resp:
            raw = resp.read().decode("utf-8", errors="replace")
            status = getattr(resp, "status", 200)
    except urllib.error.HTTPError as exc:
        body = exc.read().decode("utf-8", errors="replace")
        return _emit({"ok": False, "error": f"HTTP {exc.code}", "body": body[:300]}, 1)
    except urllib.error.URLError as exc:
        # str(exc.reason) never contains the URL path/token for DNS/TLS/timeout errors.
        return _emit({"ok": False, "error": f"URL error: {exc.reason}"}, 1)

    try:
        parsed = json.loads(raw) if raw.strip() else {}
    except json.JSONDecodeError:
        parsed = {"raw": raw[:300]}
    return _emit(
        {"ok": True, "status": status, "applicant_verified": bool(args.applicant_verified), "response": parsed},
        0,
    )


if __name__ == "__main__":
    raise SystemExit(main())
