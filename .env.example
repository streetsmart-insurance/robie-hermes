# ==========================================
# Daily Renewal Automation Configuration
# ==========================================

# 1. Renewal Window & Outreach Cadence
RENEWAL_WINDOW_MIN_DAYS=25
RENEWAL_WINDOW_MAX_DAYS=45
FOLLOWUP_CADENCE_MIN_DAYS=5
FOLLOWUP_CADENCE_MAX_DAYS=7
MAX_FOLLOWUPS=3
CSR_ESCALATION_THRESHOLD_DAYS=25

# 2. Gmail Outreach (Robie) & Polling Inboxes (Robie + Hello)
GMAIL_OUTREACH_EMAIL=robie@streetsmart.insurance
GMAIL_POLL_INBOXES=["robie@streetsmart.insurance", "hello@streetsmart.insurance"]
GMAIL_CREDENTIALS_FILE=data/credentials/credentials.json
GMAIL_TOKEN_FILE=data/credentials/token_robie.json
GMAIL_HELLO_TOKEN_FILE=data/credentials/token_hello.json
# Optional for Cloud (base64-encoded token or service key JSON)
GMAIL_TOKEN_BASE64=

# 3. EZLynx API & UI Configuration
EZLYNX_BASE_URL=https://app.ezlynx.com
EZLYNX_API_BASE_URL=https://api.ezlynx.com
EZLYNX_CLIENT_ID=street_smart_api
EZLYNX_CLIENT_SECRET=
EZLYNX_AGENCY_ID=
EZLYNX_USERNAME=
EZLYNX_PASSWORD=
EZLYNX_USER_DATA_DIR=~/.ezlynx_chrome_profile
EZLYNX_CDP_ENDPOINT=

# 4. Playwright Headless Browser Settings (Local / Cloud)
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_BROWSER_TIMEOUT_MS=60000

# 5. Storage & Paths
DATABASE_URL=sqlite:///data/renewals.db
DOWNLOADS_DIR=data/downloads
INPUT_REPORTS_DIR=data/input_reports
LOG_LEVEL=INFO
