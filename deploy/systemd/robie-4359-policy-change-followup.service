[Unit]
Description=ROBIE daily 4359 policy-change follow-up (reply tracking, confirmation, 14-day escalation)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=streetsmart-hermes
Group=streetsmart-hermes
UMask=0077
# Pinned via the /opt/streetsmart-hermes/4359-weekly symlink so the main
# production pointer (/opt/streetsmart-hermes/current) is never flipped for
# this worker. Re-pin the symlink on each 4359 release (see RUNBOOK-followup.md).
WorkingDirectory=/opt/streetsmart-hermes/4359-weekly
Environment=PYTHONPATH=/opt/streetsmart-hermes/4359-weekly
Environment=ROBIE_ENV=PRODUCTION
# DRY-RUN PINNED: the escalation digest to Carlo must not send until he
# reviews the live-data dry-run evidence and explicitly approves live mode.
# Flip to "live" only on Carlo's explicit go-ahead.
Environment=ROBIE_4359_FOLLOWUP_MODE=dry-run
Environment=ROBIE_4359_MANIFEST=/etc/streetsmart-hermes/robie-4359-manifest.json
Environment=ROBIE_4359_SENT_STORE=/opt/streetsmart-hermes/robie-job-engine/data/overdue_policy_change_reports/sent.json
Environment=ROBIE_4359_FOLLOWUP_STORE=/opt/streetsmart-hermes/robie-job-engine/data/overdue_policy_change_reports/followup.json
# Optional overrides (report mailbox, freshness bar). Values in this file
# win over the Environment= defaults above.
EnvironmentFile=-/etc/streetsmart-hermes/robie-4359.env
# EZLynx API client credentials for the read-only DocumentApi confirmation
# check (names only; values live in Secret Manager / this env file on the box).
EnvironmentFile=-/etc/streetsmart-hermes/robie-ezlynx.env
# Keyless-delegated Gmail service account used to READ the daily 4359 CSV
# and the CSR reply threads, and (in live mode) SEND the escalation digest.
EnvironmentFile=-/etc/streetsmart-hermes/robie-accountability.env
# Ensure the state/evidence directory exists and is service-owned
# (ProtectSystem=strict keeps /opt read-only otherwise).
ExecStartPre=+/usr/bin/install -d -o streetsmart-hermes -g streetsmart-hermes -m 0750 /opt/streetsmart-hermes/robie-job-engine/data/overdue_policy_change_reports
ExecStart=/opt/streetsmart-hermes/venv/bin/python -m robie_job_engine.run_policy_change_followup --evidence-out /opt/streetsmart-hermes/robie-job-engine/data/overdue_policy_change_reports/evidence-followup-latest.json
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/streetsmart-hermes/robie-job-engine/data/overdue_policy_change_reports
TimeoutStartSec=30min

[Install]
WantedBy=multi-user.target
