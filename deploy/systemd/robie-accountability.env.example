# Paths only. Copy secret values from Secret Manager at runtime; never commit them.
ROBIE_ACCOUNTABILITY_MANIFEST=/opt/streetsmart-hermes/accountability/connection-manifest.json

# Optional RingCentral read-only API path. Scheduled email reports may be used instead.
RINGCENTRAL_CLIENT_ID=
RINGCENTRAL_CLIENT_SECRET=
RINGCENTRAL_JWT=

# Existing EZLynx Secret Manager references.
ROBIE_EZLYNX_USERNAME_SECRET=projects/<project-id>/secrets/ezlynx-username/versions/latest
ROBIE_EZLYNX_PASSWORD_SECRET=projects/<project-id>/secrets/ezlynx-password/versions/latest

# AppSheet read-only Find integration (Enterprise plan only).
APPSHEET_APP_ID=
APPSHEET_APPLICATION_ACCESS_KEY=
APPSHEET_REGION=www.appsheet.com

# Agency Gmail metadata auditing. Use keyless service-account signing after Workspace admin approval.
ACCOUNTABILITY_GMAIL_DELEGATED_SERVICE_ACCOUNT=
ACCOUNTABILITY_REPORT_MAILBOX=robie@streetsmart.insurance
# Explicit comma-separated mailbox allowlist; never audit the whole domain implicitly.
ACCOUNTABILITY_GMAIL_USERS=jackie@streetsmart.insurance,jazmin@streetsmart.insurance
# Domain-wide delegation scopes required when enabled:
# gmail.metadata (mailbox accountability + delivery read-back) and gmail.send.
