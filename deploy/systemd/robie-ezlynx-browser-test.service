[Unit]
Description=ROBIE Test-only persistent EZLynx Chrome profile
After=network-online.target
Wants=network-online.target
ConditionHost=hermes-test-01.c.streetsmart-hermes-poc.internal
# Rate-limit Restart=always so a flush/CDP race cannot thrash Chrome.
# Daily robie-chrome-refresh at 3:30 AM ET is the intentional restart.
StartLimitIntervalSec=10min
StartLimitBurst=3

[Service]
Type=simple
User=streetsmart-hermes-test
Group=streetsmart-hermes-test
UMask=0077
Environment=HOME=/opt/streetsmart-hermes-test/.hermes/browser-profiles/ezlynx
# Optional proxy routing for bot-walled carrier portals. See
# deploy/systemd/robie-ezlynx-browser.service for the documented contract
# (including WHY ExecStart is wrapped in /bin/sh -c 'exec ...': a bare
# ${PROXY_CHROME_FLAGS} expands to an empty argv entry when the env file is
# absent, and Chrome exits 13 on it).
EnvironmentFile=-/etc/streetsmart-hermes/robie-browser-proxy.env
ExecStart=/bin/sh -c 'exec /usr/bin/google-chrome --headless=new --disable-gpu --disable-dev-shm-usage --remote-debugging-address=127.0.0.1 --remote-debugging-port=9222 $$PROXY_CHROME_FLAGS --user-data-dir=/opt/streetsmart-hermes-test/.hermes/browser-profiles/ezlynx --disk-cache-dir=/opt/streetsmart-hermes-test/.hermes/cache/chrome-ezlynx --no-first-run --no-default-browser-check about:blank'
Restart=always
RestartSec=5
TimeoutStopSec=30
KillMode=mixed
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/streetsmart-hermes-test/.hermes/browser-profiles/ezlynx /opt/streetsmart-hermes-test/.hermes/cache/chrome-ezlynx

[Install]
WantedBy=multi-user.target
