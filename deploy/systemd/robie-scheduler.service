[Unit]
Description=ROBIE durable Job Engine scheduler tick
After=local-fs.target network-online.target robie-ezlynx-browser.service
Wants=network-online.target robie-ezlynx-browser.service

[Service]
Type=oneshot
User=streetsmart-hermes
Group=streetsmart-hermes
WorkingDirectory=/opt/streetsmart-hermes/robie-job-engine
Environment=PYTHONPATH=/opt/streetsmart-hermes/robie-job-engine
Environment=ROBIE_DASHBOARD_SHEET_ID=1Qj0-i4QJuNkfWtjdfAdpQpI1JmC44KmThr_rrzGG6EQ
EnvironmentFile=-/etc/streetsmart-hermes/robie-recording.env
ExecStart=/opt/streetsmart-hermes/.hermes/hermes-agent/venv/bin/python -m robie_job_engine.scheduler
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/streetsmart-hermes/robie-job-engine/data

[Install]
WantedBy=multi-user.target
