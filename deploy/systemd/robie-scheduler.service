[Unit]
Description=ROBIE durable Job Engine scheduler tick
After=local-fs.target network-online.target robie-ezlynx-browser.service
Wants=network-online.target robie-ezlynx-browser.service
OnFailure=robie-scheduler-alert@%n.service

[Service]
Type=oneshot
User=streetsmart-hermes
Group=streetsmart-hermes
WorkingDirectory=/opt/streetsmart-hermes/releases/current
Environment=PYTHONPATH=/opt/streetsmart-hermes/releases/current
Environment=ROBIE_DASHBOARD_SHEET_ID=1Qj0-i4QJuNkfWtjdfAdpQpI1JmC44KmThr_rrzGG6EQ
Environment=ROBIE_JOB_DB=/opt/streetsmart-hermes/robie-job-engine/data/jobs.db
Environment=ROBIE_ENABLE_EZLYNX_SESSION_REFRESH=1
Environment=ROBIE_EZLYNX_SESSION_REFRESH_LOCAL_TIME=05:30
Environment=ROBIE_EZLYNX_SESSION_REFRESH_TIMEZONE=America/New_York
Environment=ROBIE_EZLYNX_SESSION_LOCK=/opt/streetsmart-hermes/robie-job-engine/data/ezlynx-session.lock
Environment=ROBIE_EZLYNX_LOGIN_HELPER=/opt/streetsmart-hermes/releases/current/ezlynx_login_bootstrap.py
EnvironmentFile=-/etc/streetsmart-hermes/robie-recording.env
# EZLynx Secret Manager resource names (names only, never values), written by
# the repair-production-scheduler-unit workflow at deploy time.
EnvironmentFile=-/etc/streetsmart-hermes/robie-ezlynx.env
# Ensure the job DB directory exists and is service-owned before the
# sandboxed tick runs (ProtectSystem=strict keeps /opt read-only).
ExecStartPre=+/usr/bin/install -d -o streetsmart-hermes -g streetsmart-hermes -m 0750 /opt/streetsmart-hermes/robie-job-engine/data
ExecStart=/opt/streetsmart-hermes/venv/bin/python -m robie_job_engine.scheduler
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/streetsmart-hermes/robie-job-engine/data

[Install]
WantedBy=multi-user.target
