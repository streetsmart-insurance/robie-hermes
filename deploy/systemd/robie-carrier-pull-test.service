[Unit]
Description=ROBIE Test-only daily carrier document pull (dry run; EZLynx filing off; Drive QA upload)
After=network-online.target robie-carrier-browser-test.service
Wants=network-online.target robie-carrier-browser-test.service
[Service]
Type=oneshot
User=streetsmart-hermes-test
Group=streetsmart-hermes-test
UMask=0077
# Runs from its own staged release, never Test's current link:
#   /var/lib/robie-carrier-pull-test/release -> releases/<sha>/robie-hermes-<sha>
WorkingDirectory=/var/lib/robie-carrier-pull-test/release
Environment=PYTHONPATH=/var/lib/robie-carrier-pull-test/release
Environment=ROBIE_ENV=TEST
Environment=ROBIE_DOCUMENT_RETRIEVAL_FILE_EZLYNX=0
# The CDP URL is passed on the command line (EnvironmentFile values override
# Environment=, and robie-recording.env points ROBIE_BROWSER_CDP_URL at the
# EZLynx Chrome on 9222). The runner refuses any port but 9223.
Environment=HOME=/opt/streetsmart-hermes-test
Environment=ACCOUNTABILITY_GMAIL_DELEGATED_SERVICE_ACCOUNT=robie-test-drive-reader@streetsmart-hermes-poc.iam.gserviceaccount.com
Environment=UTICA_MFA_MAILBOX=carlo@streetsmart.insurance
# ROBIE_GOOGLE_TOKEN_FILE: the Test Drive token (Drive upload only).
EnvironmentFile=-/etc/streetsmart-hermes-test/robie-recording.env
EnvironmentFile=-/etc/streetsmart-hermes-test/robie-carrier-pull.env
# --notify posts the plain-English summary to ROBIE_HEALTH_CHAT_SPACE (same
# ROBIE health Chat Prod uses). Space and Chat app key come from
# robie-carrier-pull.env. The summary is also written to runs/<date>/summary.txt.
ExecStart=/opt/streetsmart-hermes-test/venv/bin/python -m robie_job_engine.carrier_daily_run --root /var/lib/robie-carrier-pull-test --cdp-url http://127.0.0.1:9223 --upload-drive --notify
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/robie-carrier-pull-test /opt/streetsmart-hermes-test/.hermes
TimeoutStartSec=4h
[Install]
WantedBy=multi-user.target
