[Unit]
Description=ROBIE morning health digest (explicit all-green or the failure list)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=streetsmart-hermes
Group=streetsmart-hermes
WorkingDirectory=/opt/streetsmart-hermes/releases/current
Environment=PYTHONPATH=/opt/streetsmart-hermes/releases/current
Environment=ROBIE_CANONICAL_JOB_ENGINE_ROOT=/opt/streetsmart-hermes/releases/current
Environment=ROBIE_CHAT_SA_KEY_FILE=/etc/streetsmart-hermes/robie-chat-sa-key.json
Environment=ASCEND_DRIVER_STATE_DIR=/var/lib/robie-ascend-notice-driver
# streetsmart-hermes cannot exec the hermes-agent venv: /opt/streetsmart-hermes/.hermes is 0700 carlo.
ExecStart=/opt/streetsmart-hermes/venv/bin/python /opt/streetsmart-hermes/releases/current/scripts/robie_health_check.py --daily-digest
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/tmp/robie-health

[Install]
WantedBy=multi-user.target
