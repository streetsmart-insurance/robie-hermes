[Unit]
Description=Hermes Agent Gateway - Messaging Platform Integration
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=streetsmart-hermes
Group=streetsmart-hermes
ExecStart=/home/streetsmart-hermes/.hermes/hermes-agent/venv/bin/python -m hermes_cli.main gateway run
WorkingDirectory=/home/streetsmart-hermes/.hermes
Environment="HOME=/home/streetsmart-hermes"
Environment="USER=streetsmart-hermes"
Environment="LOGNAME=streetsmart-hermes"
Environment="PATH=/opt/streetsmart-hermes/.local/bin:/home/streetsmart-hermes/.hermes/hermes-agent/venv/bin:/home/streetsmart-hermes/.hermes/hermes-agent/node_modules/.bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="VIRTUAL_ENV=/home/streetsmart-hermes/.hermes/hermes-agent/venv"
Environment="HERMES_HOME=/home/streetsmart-hermes/.hermes"
Restart=always
RestartSec=5
RestartForceExitStatus=75
RestartPreventExitStatus=78
KillMode=mixed
KillSignal=SIGTERM
ExecReload=/bin/kill -USR1 $MAINPID
ExecStopPost=-/home/streetsmart-hermes/.hermes/hermes-agent/venv/bin/python -m gateway.cgroup_cleanup
TimeoutStopSec=60
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
