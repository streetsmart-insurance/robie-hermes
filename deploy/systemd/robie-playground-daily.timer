# Test host only. This pull request does not install or enable this timer.
# 7:00 AM America/New_York, every day. Persistent so a missed morning
# still sends after the VM comes back.
# Do not install on hermes-poc-01.

[Unit]
Description=Daily Playground change list for Carlo
ConditionHost=hermes-test-01.c.streetsmart-hermes-poc.internal

[Timer]
OnCalendar=*-*-* 07:00:00 America/New_York
Persistent=true
AccuracySec=1min
Unit=robie-playground-daily.service

[Install]
WantedBy=timers.target
