# hermes-email-watcher.service
# Install as /etc/streetsmart-hermes/hermes-email-watcher.env with mode 0600.
# Do not commit a key file. Point ROBIE_CHAT_SA_KEY_FILE at the secret mount.
#
# Without ROBIE_CHAT_SA_KEY_FILE the watcher cannot post Chat HITL and will
# send help mail to carlo@streetsmart.insurance instead. Do not put the key
# JSON in this file.

ROBIE_CHAT_SA_KEY_FILE=/etc/streetsmart-hermes/secrets/robie-chat-sa.json
ROBIE_CHAT_APP_CLIENT_EMAIL=robie-chat@streetsmart-hermes-poc.iam.gserviceaccount.com

# How many inbox emails run at once. EZLynx-writing jobs still take the
# session lock one at a time. Default 2.
ROBIE_EMAIL_WORKER_CONCURRENCY=2

# Chat step inside one email job. This is the ~10 minute cutoff.
# The watcher process limit stays 930 seconds and does not fire first.
ROBIE_EMAIL_AGENT_TIMEOUT_SECONDS=600

# Chat turn ceiling (adapter). Does not change agent.max_turns in config.yaml.
ROBIE_GATEWAY_MAX_TURN_SECONDS=600
