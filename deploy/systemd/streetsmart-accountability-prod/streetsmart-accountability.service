[Unit]
Description=StreetSmart prior-business-day accountability report
Wants=network-online.target
After=network-online.target robie-ezlynx-chrome.service
OnFailure=streetsmart-accountability-alert@%n.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/streetsmart-daily-accountability
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/streetsmart-daily-accountability/scripts/run_daily_accountability_vm.sh
TimeoutStartSec=65min
Nice=10

[Install]
WantedBy=multi-user.target
