[Unit]
Description=ROBIE persistent Magellan Chrome profile
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=streetsmart-hermes
Group=streetsmart-hermes
UMask=0077
Environment=HOME=/opt/streetsmart-hermes
# Optional proxy routing for bot-walled carrier portals. See
# deploy/systemd/robie-ezlynx-browser.service for the documented contract
# (including WHY ExecStart is wrapped in /bin/sh -c 'exec ...': a bare
# ${PROXY_CHROME_FLAGS} expands to an empty argv entry when the env file is
# absent, and Chrome exits 13 on it).
EnvironmentFile=-/etc/streetsmart-hermes/robie-browser-proxy.env
ExecStart=/bin/sh -c 'exec /usr/bin/google-chrome --headless=new --disable-gpu --disable-dev-shm-usage --remote-debugging-address=127.0.0.1 --remote-debugging-port=9223 $$PROXY_CHROME_FLAGS --user-data-dir=/opt/streetsmart-hermes/.hermes/browser-profiles/magellan --disk-cache-dir=/opt/streetsmart-hermes/.hermes/cache/chrome-magellan --no-first-run --no-default-browser-check https://app.magellan.insure/dashboard'
Restart=always
RestartSec=5
TimeoutStopSec=30
KillMode=mixed
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/streetsmart-hermes/.hermes/browser-profiles/magellan /opt/streetsmart-hermes/.hermes/cache/chrome-magellan

[Install]
WantedBy=multi-user.target
