[Unit]
Description=ROBIE persistent EZLynx Chrome profile
After=network-online.target
Wants=network-online.target
# Rate-limit Restart=always so a flush/CDP race cannot thrash Chrome
# (hermes-poc-01 afternoon loop: restart counter ~16→23 in ~30 min).
# Daily robie-chrome-refresh.timer at 3:30 AM ET was the intentional restart.
# A restart without login is the bug. Session heal is
# monitor-ezlynx-session.yml. These comments do not change ExecStart
# and must not be applied to the live unit without an explicit box change.
StartLimitIntervalSec=10min
StartLimitBurst=3

[Service]
Type=simple
User=streetsmart-hermes
Group=streetsmart-hermes
UMask=0077
Environment=HOME=/opt/streetsmart-hermes
ExecStart=/usr/bin/google-chrome --headless=new --disable-gpu --disable-dev-shm-usage --remote-debugging-address=127.0.0.1 --remote-debugging-port=9222 --user-data-dir=/opt/streetsmart-hermes/.hermes/browser-profiles/ezlynx --disk-cache-dir=/opt/streetsmart-hermes/.hermes/cache/chrome-ezlynx --no-first-run --no-default-browser-check about:blank
Restart=always
RestartSec=5
TimeoutStopSec=30
KillMode=mixed
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/streetsmart-hermes/.hermes/browser-profiles/ezlynx /opt/streetsmart-hermes/.hermes/cache/chrome-ezlynx

[Install]
WantedBy=multi-user.target
