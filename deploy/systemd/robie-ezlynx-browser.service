[Unit]
Description=ROBIE persistent EZLynx Chrome profile
After=network-online.target
Wants=network-online.target
# Rate-limit Restart=always so a flush/CDP race cannot thrash Chrome
# (hermes-poc-01 afternoon loop: restart counter ~16→23 in ~30 min).
# Daily robie-chrome-refresh.timer at 3:30 AM ET is the intentional restart.
StartLimitIntervalSec=10min
StartLimitBurst=3

[Service]
Type=simple
User=streetsmart-hermes
Group=streetsmart-hermes
UMask=0077
Environment=HOME=/opt/streetsmart-hermes
# Optional proxy routing for bot-walled carrier portals. When the file exists it
# must define PROXY_CHROME_FLAGS, e.g.:
#   PROXY_CHROME_FLAGS=--proxy-server=http://proxy.webshare.io:8080
# Prefer Webshare IP-auth (whitelist the box egress IP in the Webshare dashboard)
# so no proxy credentials live on the box. The leading '-' makes the file optional:
# without it Chrome launches exactly as before (direct egress).
EnvironmentFile=-/etc/streetsmart-hermes/robie-browser-proxy.env
ExecStart=/usr/bin/google-chrome --headless=new --disable-gpu --disable-dev-shm-usage --remote-debugging-address=127.0.0.1 --remote-debugging-port=9222 ${PROXY_CHROME_FLAGS} --user-data-dir=/opt/streetsmart-hermes/.hermes/browser-profiles/ezlynx --disk-cache-dir=/opt/streetsmart-hermes/.hermes/cache/chrome-ezlynx --no-first-run --no-default-browser-check about:blank
Restart=always
RestartSec=5
TimeoutStopSec=30
KillMode=mixed
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/streetsmart-hermes/.hermes/browser-profiles/ezlynx /opt/streetsmart-hermes/.hermes/cache/chrome-ezlynx

[Install]
WantedBy=multi-user.target
