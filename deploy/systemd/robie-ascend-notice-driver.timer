[Unit]
Description=ROBIE Ascend notice driver every 15 minutes
Documentation=file:/opt/streetsmart-hermes/current/scripts/install-ascend-notice-driver.sh

[Timer]
OnBootSec=5min
OnUnitActiveSec=15min
Persistent=true
AccuracySec=1min
Unit=robie-ascend-notice-driver.service

[Install]
WantedBy=timers.target
