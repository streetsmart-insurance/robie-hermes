[Unit]
Description=Run the ROBIE daily 4359 liveness publisher every morning 06:30 ET (before the daily accountability report)

[Timer]
OnCalendar=*-*-* 06:30:00 America/New_York
Persistent=true
AccuracySec=1s
RandomizedDelaySec=0
Unit=robie-4359-liveness-publish.service

[Install]
WantedBy=timers.target
