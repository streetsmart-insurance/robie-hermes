# Install as /etc/streetsmart-hermes/robie-recording.env with mode 0600.
# Never commit the populated file or a Google OAuth token to GitHub.
ROBIE_RECORD_ALL_JOBS=1
ROBIE_RECORDING_ROOT=/opt/streetsmart-hermes/robie-job-engine/data/recordings
ROBIE_BROWSER_CDP_URL=http://127.0.0.1:9222
ROBIE_RECORDING_FPS=4
ROBIE_DELETE_LOCAL_RECORDING_AFTER_UPLOAD=1

# Required production values:
# ROBIE_RECORDINGS_DRIVE_FOLDER_ID=<shared-drive-folder-id>
# ROBIE_GOOGLE_TOKEN_FILE=/opt/streetsmart-hermes/secrets/google-workspace-token.json
