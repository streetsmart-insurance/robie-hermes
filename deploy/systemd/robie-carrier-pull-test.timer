[Unit]
Description=Weekday 07:30 ET schedule for the ROBIE Test daily carrier document pull
[Timer]
# Persistent=false: enabling the timer never starts a catch-up run.
OnCalendar=Mon..Fri *-*-* 07:30:00 America/New_York
Persistent=false
AccuracySec=1min
RandomizedDelaySec=0
Unit=robie-carrier-pull-test.service
[Install]
WantedBy=timers.target
