# Example only. Do not commit real tokens. Copy to
# /etc/streetsmart-hermes/robie-playground.env on hermes-test-01
# after Carlo creates the "Robie Playground" Chat space.
# This pull request does not install this file.
#
# The Playground stays off until ROBIE_PLAYGROUND=1.
# Real clients stay closed until ROBIE_EZLYNX_WRITE_SCOPE=all.
# That is honored only while ROBIE_PLAYGROUND=1 and the Playground
# guardrails are active. Leave it unset on Test until those are proven.
# Prod flip, later, after QA, and not by this pull request:
#   ROBIE_PLAYGROUND=1
#   ROBIE_EZLYNX_WRITE_SCOPE=all

ROBIE_PLAYGROUND=0
ROBIE_PLAYGROUND_SPACE_ID=
ROBIE_PLAYGROUND_REAL_CLIENTS=0
ROBIE_PLAYGROUND_LIVE_WRITES=0
ROBIE_EZLYNX_WRITE_SCOPE=
ROBIE_EZLYNX_WRITE_APPLICANT_IDS=26356199
ROBIE_PLAYGROUND_PRACTICE_APPLICANT_IDS=26356199,220250093
ROBIE_PLAYGROUND_CARRIER_EMAIL_SINK=carlo@streetsmart.insurance
ROBIE_PLAYGROUND_CONFIRM_TIMEOUT_MINUTES=30
ROBIE_PLAYGROUND_DIGEST_CHAT_USER=carlo@streetsmart.insurance
# Optional override. Defaults are the StreetSmart SOP folders.
# ROBIE_PLAYGROUND_SOP_FOLDERS=core:1nwtIlz07UNNloBR8zqDOSOKEU64m6YdE,commercial:1rptPZ4bR6CkPysojnicrBRyDbypZpQGO
ROBIE_PLAYGROUND_SOP_INDEX=/opt/streetsmart-hermes-test/robie-job-engine/data/playground-sop-index.json
# Memory is playground_memory.db next to ROBIE_JOB_DB. No separate setting.
