{
  "safety": {
    "environment": "Test",
    "manual_weekday_runs_only": true,
    "production_allowed": false,
    "email_delivery_enabled": false,
    "google_chat_delivery_enabled": false
  },
  "output_dir": "/opt/streetsmart-hermes/accountability/reports",
  "sources": {
    "ringcentral": "/opt/streetsmart-hermes/accountability/inbox/ringcentral.csv",
    "tasks": "/opt/streetsmart-hermes/accountability/inbox/ezlynx_tasks.csv",
    "activities": "/opt/streetsmart-hermes/accountability/inbox/ezlynx_activities.csv",
    "sales": "/opt/streetsmart-hermes/accountability/inbox/ezlynx_sales_center.csv",
    "sales_json": "/opt/streetsmart-hermes/accountability/inbox/sales_summary.json",
    "retention": "/opt/streetsmart-hermes/accountability/inbox/retention.csv",
    "retention_summary_json": "/opt/streetsmart-hermes/accountability/inbox/retention_summary.json",
    "submissions": "/opt/streetsmart-hermes/accountability/inbox/submissions.csv",
    "email_json": "/opt/streetsmart-hermes/accountability/inbox/email_summary.json",
    "appsheet_json": "/opt/streetsmart-hermes/accountability/inbox/appsheet_summary.json",
    "magellan_json": "/opt/streetsmart-hermes/accountability/inbox/magellan_summary.json",
    "roles_json": "/opt/streetsmart-hermes/accountability/inbox/employee_roles.json",
    "monthly_kpis_json": "/opt/streetsmart-hermes/accountability/inbox/monthly_kpis.json",
    "churn_json": "/opt/streetsmart-hermes/accountability/inbox/churn_cases.json",
    "trackers": {
      "bor": "/opt/streetsmart-hermes/accountability/inbox/bor.csv",
      "policy_changes": "/opt/streetsmart-hermes/accountability/inbox/policy_changes.csv",
      "referrals": "/opt/streetsmart-hermes/accountability/inbox/referrals.csv",
      "missed_calls": "/opt/streetsmart-hermes/accountability/inbox/missed_calls.csv",
      "coi_endorsements": "/opt/streetsmart-hermes/accountability/inbox/coi_endorsements.csv",
      "expirations": "/opt/streetsmart-hermes/accountability/inbox/expirations.csv",
      "voicemail_email": "/opt/streetsmart-hermes/accountability/inbox/voicemail_email.csv",
      "case_studies": "/opt/streetsmart-hermes/accountability/inbox/case_studies.csv",
      "policy_transactions": "/opt/streetsmart-hermes/accountability/inbox/policy_transactions.csv"
    }
  },
  "rules": {
    "sales_untouched_days": 5,
    "submission_open_days": 30,
    "callback_sla_minutes": 30,
    "business_timezone": "America/New_York",
    "business_days": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
    "business_hours": {"start": "09:00", "end": "17:00"},
    "holiday_calendar": "US-FEDERAL",
    "daily_reporting_period": "previous_business_day",
    "coi_target": "same_business_day",
    "policy_change_escalation_days": 7,
    "require_complete_evidence": true
  },
  "collection": {
    "gmail_accountability": {
      "enabled": false,
      "scope": "https://www.googleapis.com/auth/gmail.metadata",
      "allowlist_source": "approved_active_employee_roster",
      "approved_domain": "streetsmart.insurance",
      "require_every_mailbox_verified": true,
      "message_bodies_enabled": false
    },
    "ringcentral_email": {
      "enabled": false,
      "mailbox": "report-mailbox@example.test",
      "max_age_hours": 36
    },
    "magellan": {
      "enabled": false,
      "read_only": true,
      "cdp_url": "http://127.0.0.1:9223",
      "project": "streetsmart-hermes-poc",
      "max_pages": 40,
      "transcripts_enabled": false
    },
    "ezlynx_submission_center": {
      "enabled": false,
      "read_only": true,
      "email_delivery_enabled": false,
      "modes": ["daily", "weekly"]
    },
    "ezlynx_reports_5": {
      "enabled": false,
      "version": "5.0",
      "base_url": "https://app.ezlynx.com/web/looker-reports",
      "legacy_saved_reports_enabled": false,
      "required_mappings": ["tasks_activities", "policy_changes", "coi", "sales", "retention", "audits"],
      "mappings": {
        "tasks_activities": {
          "verified": true,
          "dashboard": {"name": "Activity Summary", "report_id": 25979},
          "look": {"name": "Activity Detail", "report_id": 546}
        },
        "policy_changes": {
          "verified": true,
          "dashboard": {"name": "Policy Change Request Summary", "report_id": 25997},
          "look": {"name": "Change Request Detail", "report_id": 492}
        },
        "coi": {
          "verified": true,
          "source_type": "tracker_plus_account_activity",
          "look": {"name": "Activity Detail", "report_id": 546},
          "filter": {"field": "Activity Labels Activity Labels", "operator": "contains", "value": "Certificate of Insurance"},
          "account_evidence": "Open the tracker Link and reconcile the matching account Activity discussion"
        },
        "sales": {
          "verified": true,
          "dashboard": {"name": "Sales Performance Dashboard", "report_id": 25985},
          "look": {"name": "Sales Center Detail", "report_id": 3469}
        },
        "audits": {
          "verified": true,
          "source_type": "composite",
          "looks": [
            {"name": "Activity Detail", "report_id": 546},
            {"name": "Policy Transaction Detail", "report_id": 489}
          ],
          "filter": {"field": "Activity Labels Activity Labels", "operator": "contains", "value": "Audit"},
          "account_evidence": "Reconcile the activity label, policy transaction, and latest account Activity discussion"
        },
        "retention": {
          "verified": true,
          "dashboard": {"name": "Renewal Summary", "report_id": 25991},
          "looks": [
            {"name": "Premium Change Detail (EZLynx Data)", "report_id": 3688},
            {"name": "Renewal Detail", "report_id": 494}
          ]
        }
      }
    }
  },
  "google_sheet_trackers": {
    "enabled": false,
    "read_only": true,
    "trackers": {
      "coi_endorsements": {
        "spreadsheet_id": "1LXer2SjkQGvj1dsaRGmFnkB_hGBQeJolagw1oFbycZY",
        "range": "{month}!A:H",
        "allowed_columns": [
          "Date",
          "Date COI was Requested",
          "Profile",
          "Link",
          "Requirements/Endo",
          "Agent assigned to the task.",
          "Status",
          "Date Completed"
        ]
      },
      "policy_changes": {
        "spreadsheet_id": "1-_Egm_2K16aAQv8u_MqKzWJGFTEr4KA8reh_oFm3rg4",
        "range": "{previous_business_week}!A:R",
        "allowed_columns": [
          "Action",
          "Change Request Created Date",
          "Days Open",
          "Account Name",
          "Assigned Producer",
          "Branch",
          "Effective Date",
          "Line of Business",
          "Master Company",
          "Policy Number",
          "Written Premium",
          "Change Request Created By",
          "Request Status",
          "Policy Change Request ID",
          "Expiration Date",
          "Total Policy Change Requests",
          "Total Open Change Requests",
          "Column 1"
        ]
      }
    }
  },
  "appsheet": {
    "enabled": false,
    "app_id_env": "APPSHEET_APP_ID",
    "application_access_key_env": "APPSHEET_APPLICATION_ACCESS_KEY",
    "region_env": "APPSHEET_REGION",
    "tables": {}
  },
  "dashboard": {
    "enabled": false,
    "spreadsheet_id": "REPLACE_WITH_PRIVATE_CONTROL_CENTER_SHEET_ID",
    "sheet_name": "Agency Accountability",
    "inspection_range": "A1:L120",
    "environment_label": "TEST"
  },
  "google_sheets": {
    "enabled": false,
    "required_scopes": [
      "https://www.googleapis.com/auth/spreadsheets.readonly",
      "https://www.googleapis.com/auth/drive.readonly"
    ],
    "spreadsheet_id": "REPLACE_WITH_PRIVATE_APPSHEET_BACKING_SHEET_ID",
    "employee_role_table": "employees",
    "employee_role_columns": {
      "name": "name",
      "role": "position",
      "email": "email",
      "department": "department",
      "status": "employmentStatus",
      "manager": "departmentHead",
      "active_value": "Active"
    },
    "tables": {
      "employees": {
        "range": "Street Smart Employees!A:AG",
        "allowed_columns": ["name", "position", "email", "department", "employmentStatus", "departmentHead"]
      },
      "employee_performance": {
        "range": "Employee Performance!A:Z",
        "allowed_columns": ["Employee", "Date", "Metric", "Value", "Status"]
      }
    }
  },
  "delivery": {
    "enabled": false,
    "requires_exact_digest_approval": true,
    "chat_spaces": [],
    "email_sender": "report-mailbox@example.test",
    "email_recipients": {
      "daily": ["carlo@streetsmart.insurance"],
      "weekly": ["carlo@streetsmart.insurance", "jake@streetsmart.insurance"],
      "monthly": ["carlo@streetsmart.insurance", "jake@streetsmart.insurance"]
    }
  }
}
