{
  "output_dir": "/opt/streetsmart-hermes/accountability/reports",
  "sources": {
    "ringcentral": "/opt/streetsmart-hermes/accountability/inbox/ringcentral.csv",
    "tasks": "/opt/streetsmart-hermes/accountability/inbox/ezlynx_tasks.csv",
    "activities": "/opt/streetsmart-hermes/accountability/inbox/ezlynx_activities.csv",
    "sales": "/opt/streetsmart-hermes/accountability/inbox/ezlynx_sales_center.csv",
    "sales_json": "/opt/streetsmart-hermes/accountability/inbox/sales_summary.json",
    "retention": "/opt/streetsmart-hermes/accountability/inbox/retention.csv",
    "retention_summary_json": "/opt/streetsmart-hermes/accountability/inbox/retention_summary.json",
    "submissions": "/opt/streetsmart-hermes/accountability/inbox/submissions.csv",
    "email_json": "/opt/streetsmart-hermes/accountability/inbox/email_summary.json",
    "appsheet_json": "/opt/streetsmart-hermes/accountability/inbox/appsheet_summary.json",
    "magellan_json": "/opt/streetsmart-hermes/accountability/inbox/magellan_summary.json",
    "roles_json": "/opt/streetsmart-hermes/accountability/inbox/employee_roles.json",
    "monthly_kpis_json": "/opt/streetsmart-hermes/accountability/inbox/monthly_kpis.json",
    "churn_json": "/opt/streetsmart-hermes/accountability/inbox/churn_cases.json",
    "trackers": {
      "bor": "/opt/streetsmart-hermes/accountability/inbox/bor.csv",
      "policy_changes": "/opt/streetsmart-hermes/accountability/inbox/policy_changes.csv",
      "referrals": "/opt/streetsmart-hermes/accountability/inbox/referrals.csv",
      "missed_calls": "/opt/streetsmart-hermes/accountability/inbox/missed_calls.csv",
      "coi_endorsements": "/opt/streetsmart-hermes/accountability/inbox/coi_endorsements.csv",
      "expirations": "/opt/streetsmart-hermes/accountability/inbox/expirations.csv",
      "voicemail_email": "/opt/streetsmart-hermes/accountability/inbox/voicemail_email.csv",
      "case_studies": "/opt/streetsmart-hermes/accountability/inbox/case_studies.csv",
      "policy_transactions": "/opt/streetsmart-hermes/accountability/inbox/policy_transactions.csv"
    }
  },
  "rules": {
    "sales_untouched_days": 5,
    "submission_open_days": 30,
    "require_complete_evidence": true,
    "required_connection_sources": ["ringcentral", "ezlynx", "gmail", "magellan"]
  },
  "collection": {
    "ezlynx_submission_browser": {
      "enabled": false,
      "read_only": true,
      "scope": "Streetsmart Insurance",
      "time_frame": "All Submissions"
    },
    "ringcentral_email": {
      "enabled": false,
      "mailbox": "report-mailbox@example.test",
      "max_age_hours": 36
    },
    "scheduled_reports_email": {
      "enabled": false,
      "modes": ["weekly"],
      "mailbox": "report-mailbox@example.test",
      "max_age_hours": 192,
      "allowed_sender_domains": ["ezlynx.com"],
      "allowed_senders": [],
      "reports": {
        "tasks": {"label": "ROBIE_EZLYNX_TASKS", "destination": "source", "required": true, "worksheet": "Tasks", "required_columns": ["Assigned To", "Status"]},
        "activities": {"label": "ROBIE_EZLYNX_ACTIVITIES", "destination": "source", "required": true, "worksheet": "Activities", "required_columns": ["Description"]},
        "sales": {"label": "ROBIE_EZLYNX_SALES", "destination": "source", "required": true, "worksheet": "Sales Center", "required_columns": ["Assigned Producer", "Status"]},
        "retention": {"label": "ROBIE_EZLYNX_RETENTION", "destination": "source", "required": true, "worksheet": "Retention", "required_columns": ["Expiration Date", "Status"]},
        "submissions": {"label": "ROBIE_EZLYNX_SUBMISSIONS", "destination": "source", "required": true, "worksheet": "Submissions", "required_columns": ["Submission Title", "Submission URL", "Applicant", "Assigned Producer", "Status", "Quote Due Date", "Effective Date", "Overdue"]},
        "policy_changes": {"label": "ROBIE_POLICY_CHANGES", "destination": "tracker", "required": true, "worksheet": "Policy Changes", "required_columns": ["Status", "Request Date"]},
        "coi_endorsements": {"label": "ROBIE_COI_ENDORSEMENTS", "destination": "tracker", "required": true, "worksheet": "Certificates", "required_columns": ["Status", "Request Date"]},
        "expirations": {"label": "ROBIE_EXPIRATIONS", "destination": "tracker", "required": true, "worksheet": "Expirations", "required_columns": ["Status", "Expiration Date"]}
      }
    },
    "gmail": {
      "confirmed_scopes": [],
      "agency_domains": ["streetsmart.insurance"],
      "excluded_mailboxes": [],
      "mailbox_aliases": {},
      "stalled_hours": 24,
      "max_threads": 500
    },
    "evidence_email": {
      "enabled": false,
      "mailbox": "report-mailbox@example.test",
      "sources": {
        "magellan_json": {
          "sender_allowlist": ["verified-sender@example.test"],
          "subject_markers": ["ROBIE_MAGELLAN"],
          "filename_markers": ["magellan"],
          "extensions": [".json"],
          "required_json_keys": ["source_status", "records", "by_employee"],
          "modes": ["daily", "weekly"],
          "max_age_hours": 36
        }
      }
    }
  },
  "appsheet": {
    "enabled": false,
    "app_id_env": "APPSHEET_APP_ID",
    "application_access_key_env": "APPSHEET_APPLICATION_ACCESS_KEY",
    "region_env": "APPSHEET_REGION",
    "tables": {}
  },
  "dashboard": {
    "enabled": false,
    "spreadsheet_id": "REPLACE_WITH_PRIVATE_CONTROL_CENTER_SHEET_ID",
    "sheet_name": "Agency Accountability",
    "inspection_range": "A1:L120",
    "environment_label": "TEST"
  },
  "google_sheets": {
    "enabled": false,
    "spreadsheet_id": "REPLACE_WITH_PRIVATE_APPSHEET_BACKING_SHEET_ID",
    "employee_role_table": "employees",
    "employee_role_columns": {"name": "Name", "role": "Role", "email": "Email"},
    "tables": {
      "employees": {
        "range": "Employees!A:Z",
        "allowed_columns": ["Name", "Role", "Email", "Department", "Active"]
      },
      "employee_performance": {
        "range": "Employee Performance!A:Z",
        "allowed_columns": ["Employee", "Date", "Metric", "Value", "Status"]
      }
    }
  },
  "delivery": {
    "enabled": false,
    "chat_spaces": [],
    "email_sender": "report-mailbox@example.test",
    "email_recipients": {
      "daily": ["leader.one@example.test", "leader.two@example.test"],
      "weekly": ["leader.one@example.test", "leader.two@example.test"],
      "monthly": ["leader.one@example.test", "leader.two@example.test"]
    }
  }
}
